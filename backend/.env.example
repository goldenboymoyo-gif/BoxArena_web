# Copy to .env for local development. NEVER commit a real .env file.
# In staging/production, set these via your secret manager (not a checked-in file).

ENVIRONMENT_NAME=development
DJANGO_SETTINGS_MODULE=pugnera.settings.dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

DATABASE_URL=postgres://pugnera:pugnera@localhost:5432/pugnera
DB_SSL_MODE=prefer

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Object storage (profile images, fighter photos, videos, event media) ---
MEDIA_BUCKET_NAME=
MEDIA_BUCKET_REGION=
MEDIA_BUCKET_ENDPOINT=
MEDIA_BUCKET_ACCESS_KEY=
MEDIA_BUCKET_SECRET_KEY=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pugnera <no-reply@pugnera.com>

# --- Monitoring ---
SENTRY_DSN=

# --- Payments ---
# "mock" is the only provider wired up until a real provider's Zimbabwe
# availability and API docs have been verified. See backend/README.md.
ACTIVE_PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER_PUBLIC_KEY=

CELERY_TASK_ALWAYS_EAGER=True

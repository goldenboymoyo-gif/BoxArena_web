# Shared secret required to call the /api/admin/sources* routes (create,
# update, delete, or force-refresh live stream sources).
#
# These routes are fail-closed: if this is unset, they return 503 rather
# than allowing anonymous access. Generate a long random value, e.g.:
#   openssl rand -hex 32
#
# Send it back as either header when calling the admin API:
#   Authorization: Bearer <token>
#   x-admin-token: <token>
ADMIN_API_TOKEN=<bb9eb25042eb7537eb2c4bb6fcfa6b38467ee42993ee6ddaeee2839b491e9edd>
